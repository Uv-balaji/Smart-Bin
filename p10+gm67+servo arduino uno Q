#define GLYPH_W      (5 + BOLD_X)
#define GLYPH_H      (7 + BOLD_Y)
#define CHAR_ADVANCE (GLYPH_W + 1)

void drawCharBold(int x, int y, char c) {
  if (c < 32 || c > 126) c = 32;
  const byte *glyph = font5x7[c - 32];
  for (int col = 0; col < 5; col++) {
    byte colBits = glyph[col];
    for (int row = 0; row < 7; row++) {
      if (!(colBits & (1 << row))) continue;
      for (int dx = 0; dx <= BOLD_X; dx++)
        for (int dy = 0; dy <= BOLD_Y; dy++)
          writePixel(x + col + dx, y + row + dy, true);
    }
  }
}

void drawStringBold(int x, int y, const char *str) {
  int cx = x;
  while (*str) {
    if (cx > -GLYPH_W && cx < PANEL_WIDTH_PIXELS) drawCharBold(cx, y, *str);
    cx += CHAR_ADVANCE;
    str++;
  }
}

// ============================================================
//  Scroll helpers
// ============================================================
void renderFrame() {
  clearScreen(true);
  drawStringBold(scrollX, textY, scrollBuf);
}

void setText(const char *s) {
  strncpy(scrollBuf, s, MAX_TEXT_LEN);
  scrollBuf[MAX_TEXT_LEN] = '\0';
  textPixelWidth = (int)strlen(scrollBuf) * CHAR_ADVANCE;
  scrollX = PANEL_WIDTH_PIXELS;     // enter from right edge
  renderFrame();
}

// ============================================================
//  Servo helpers
// ============================================================
void servosInit() {
  servoBio.attach(SERVO_BIO_PIN);
  servoNonBio.attach(SERVO_NONBIO_PIN);
  servoBio.write(ANGLE_CLOSED);
  servoNonBio.write(ANGLE_CLOSED);
  delay(SERVO_TRAVEL_MS);           // one-time, in setup only
#if SERVO_DETACH_WHEN_IDLE
  servoBio.detach();
  servoNonBio.detach();
#endif
}

void openLid(bool isBio) {
  activeServo = isBio ? &servoBio : &servoNonBio;
#if SERVO_DETACH_WHEN_IDLE
  activeServo->attach(isBio ? SERVO_BIO_PIN : SERVO_NONBIO_PIN);
#endif
  activeServo->write(ANGLE_OPEN);
}

void closeLid() {
  if (activeServo) activeServo->write(ANGLE_CLOSED);
}

void releaseLid() {
#if SERVO_DETACH_WHEN_IDLE
  if (activeServo) activeServo->detach();
#endif
  activeServo = NULL;
}

// ============================================================
//  State entry
// ============================================================
void enterState(AppState s, const char *text) {
  appState     = s;
  stateStartMs = millis();
  setText(text);
}

// ============================================================
//  Non-blocking barcode reader  (Serial1 = GM67)
// ============================================================
void handleBarcode() {
  while (Serial1.available()) {
    char c = Serial1.read();
    if (barcodeLen < MAX_TEXT_LEN) barcodeRaw[barcodeLen++] = c;
    lastByteMs = millis();
    receiving  = true;
  }

  if (receiving && (millis() - lastByteMs >= BARCODE_TIMEOUT_MS)) {
    receiving = false;

    while (barcodeLen > 0 &&
           (barcodeRaw[barcodeLen-1] == '\r' ||
            barcodeRaw[barcodeLen-1] == '\n' ||
            barcodeRaw[barcodeLen-1] == ' ')) {
      barcodeLen--;
    }
    barcodeRaw[barcodeLen] = '\0';

    // Accept a card ONLY when idle -> prevents repeat display
    if (barcodeLen > 0 && appState == S_IDLE) {
      enterState(S_SHOW_ID, barcodeRaw);
      Serial.print(F("ID: "));
      Serial.println(scrollBuf);
    }

    barcodeLen = 0;
  }
}

// ============================================================
//  Manual waste selection  (Serial Monitor: B or N)
// ============================================================
void handleKeyInput() {
  while (Serial.available()) {
    char k = Serial.read();

    if (appState != S_ASK_WASTE) continue;   // ignore keys otherwise

    if (k == 'b' || k == 'B') {
      openLid(true);
      enterState(S_OPEN, "BIO");
      Serial.println(F("-> BIO lid OPEN (90)"));
    }
    else if (k == 'n' || k == 'N') {
      openLid(false);
      enterState(S_OPEN, "NON BIO");
      Serial.println(F("-> NON BIO lid OPEN (90)"));
    }
  }
}

// ============================================================
//  Called when one full scroll pass completes
// ============================================================
void onScrollComplete() {
  switch (appState) {

    case S_IDLE:
    case S_ASK_WASTE:
    case S_OPEN:
    case S_CLOSING:
      scrollX = PANEL_WIDTH_PIXELS;   // these states loop their text
      break;

    case S_SHOW_ID:                   // ID shown exactly ONCE
      enterState(S_ASK_WASTE, "YOUR WASTE");
      while (Serial.available()) Serial.read();   // flush stale keys
      Serial.println(F("Press B = BIO, N = NON BIO"));
      break;

    case S_THANKS:                    // THANK YOU shown once
      enterState(S_IDLE, "SMART BIN");
      Serial.println(F("Ready. Waiting for scan..."));
      break;
  }
}

// ============================================================
//  Timed state transitions (servo motion)
// ============================================================
void handleTimers() {
  unsigned long elapsed = millis() - stateStartMs;

  if (appState == S_OPEN && elapsed >= LID_OPEN_HOLD_MS) {
    closeLid();
    enterState(S_CLOSING, "CLOSING");
    Serial.println(F("-> lid CLOSE (0)"));
  }
  else if (appState == S_CLOSING && elapsed >= SERVO_TRAVEL_MS) {
    releaseLid();
    enterState(S_THANKS, "THANK YOU");
    Serial.println(F("-> THANK YOU"));
  }
}

// ============================================================
//  setup / loop
// ============================================================
void setup() {
  Serial.begin(9600);     // USB  - monitor + manual B/N input
  Serial1.begin(9600);    // UART - GM67 scanner

  pinMode(DATA_PIN,  OUTPUT);
  pinMode(CLK_PIN,   OUTPUT);
  pinMode(OE_PIN,    OUTPUT);
  pinMode(A_PIN,     OUTPUT);
  pinMode(B_PIN,     OUTPUT);
  pinMode(LATCH_PIN, OUTPUT);

  digitalWrite(A_PIN,     LOW);
  digitalWrite(B_PIN,     LOW);
  digitalWrite(CLK_PIN,   LOW);
  digitalWrite(LATCH_PIN, LOW);
  digitalWrite(DATA_PIN,  HIGH);
  rowsOff();
  clearScreen(true);

  textY = (PANEL_HEIGHT_PIXELS - GLYPH_H) / 2;

  servosInit();                       // both lids to 0 deg

  enterState(S_IDLE, "SMART BIN");

  Serial.println(F("SMART BIN ready. Waiting for scan..."));
}

void loop() {
  scanDisplay();      // display multiplex - never block after this

  handleBarcode();    // GM67 -> ID
  handleKeyInput();   // B / N -> servo
  handleTimers();     // servo open/close timing

  unsigned long now = millis();
  if (now - lastScrollMs >= SCROLL_INTERVAL_MS) {
    lastScrollMs = now;
    scrollX--;
    if (scrollX < -(textPixelWidth + GAP_PIXELS)) {
      onScrollComplete();
    } else {
      renderFrame();
    }
  }
}
