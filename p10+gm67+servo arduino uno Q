// ============================================================
//  SMART BIN
//  P10 (32x16) LED Matrix + GM67 Scanner + 2 Servos
//
//  FLOW
//    1. Boot        -> "SMART BIN"  loops continuously
//    2. Scan card   -> ID scrolls ONCE only
//    3. Then        -> "YOUR WASTE" loops, waiting for input
//    4. Press B/N   -> matching servo 0 -> 90 (open)
//                      display shows "BIO" / "NON BIO"
//    5. After hold  -> servo 90 -> 0 (close)
//    6. Then        -> "THANK YOU" scrolls ONCE
//    7. Back to step 1
//
//  Board: any Arduino with Serial1 (Mega / Leonardo / Uno Q)
// ============================================================

#include <Servo.h>

// ---- PANEL PINS ----
#define DATA_PIN    11
#define CLK_PIN     13
#define OE_PIN       9
#define A_PIN        8
#define B_PIN        7
#define LATCH_PIN    4
#define OE_ACTIVE_LOW 1

// ---- SERVO PINS ----
#define SERVO_BIO_PIN     5
#define SERVO_NONBIO_PIN  3
#define ANGLE_CLOSED      0
#define ANGLE_OPEN       90

// Detach servos when idle: kills the pulse train, so no
// servo buzz and no ISR jitter on the display multiplex.
// Set to 0 if the flap sags under its own weight.
#define SERVO_DETACH_WHEN_IDLE 1

// ---- PANEL GEOMETRY ----
#define PANEL_WIDTH_PIXELS  32
#define PANEL_HEIGHT_PIXELS 16
#define ROW_BYTES           (PANEL_WIDTH_PIXELS / 8)
#define RAM_BYTES           (ROW_BYTES * PANEL_HEIGHT_PIXELS)
#define ROW1_OFFSET         (ROW_BYTES * 4)
#define ROW2_OFFSET         (ROW_BYTES * 8)
#define ROW3_OFFSET         (ROW_BYTES * 12)

// ---- BOLD ----
#define BOLD_X 0
#define BOLD_Y 0

// ---- SCROLL ----
#define SCROLL_INTERVAL_MS  70
#define GAP_PIXELS           8

// ---- BRIGHTNESS ----
#define ROW_SLOT_MICROS          1200
#define ROW_ON_MICROS            1000
#define ROW_BLANK_MICROS         (ROW_SLOT_MICROS - ROW_ON_MICROS)
#define ROW_SWITCH_DELAY_MICROS    60
#define POST_LATCH_BLANK_MICROS    30

// ---- BARCODE ----
#define BARCODE_TIMEOUT_MS  80
#define MAX_TEXT_LEN        64

// ---- TIMING ----
#define LID_OPEN_HOLD_MS   3000   // how long the lid stays open
#define SERVO_TRAVEL_MS     600   // time for servo to physically move 90 deg

// ============================================================
//  State machine
// ============================================================
enum AppState {
  S_IDLE,       // "SMART BIN" loops
  S_SHOW_ID,    // scanned ID scrolls exactly once
  S_ASK_WASTE,  // "YOUR WASTE" loops, waiting for B / N
  S_OPEN,       // servo at 90, category name loops
  S_CLOSING,    // servo returning to 0
  S_THANKS      // "THANK YOU" scrolls once
};
AppState appState = S_IDLE;

Servo servoBio;
Servo servoNonBio;
Servo *activeServo = NULL;

unsigned long stateStartMs = 0;

// ---- DISPLAY ----
char scrollBuf[MAX_TEXT_LEN + 1];
byte screenRAM[RAM_BYTES];
byte scanRow = 0;
const byte pixelLookup[8] = {0x80,0x40,0x20,0x10,0x08,0x04,0x02,0x01};

int  textPixelWidth;
int  textY;
int  scrollX;
unsigned long lastScrollMs = 0;

// ---- BARCODE ----
char barcodeRaw[MAX_TEXT_LEN + 1];
int  barcodeLen = 0;
bool receiving  = false;
unsigned long lastByteMs = 0;

// ============================================================
//  Low-level display
// ============================================================
inline void clockPulse() {
  digitalWrite(CLK_PIN, HIGH);
  digitalWrite(CLK_PIN, LOW);
}
inline void shiftOutByte(byte b) {
  for (int8_t i = 7; i >= 0; i--) {
    digitalWrite(DATA_PIN, (b & (1 << i)) ? HIGH : LOW);
    clockPulse();
  }
}
inline void latchPulse() {
  digitalWrite(LATCH_PIN, HIGH);
  digitalWrite(LATCH_PIN, LOW);
}

#if OE_ACTIVE_LOW
  inline void rowsOff() { digitalWrite(OE_PIN, LOW);  }
  inline void rowsOn()  { digitalWrite(OE_PIN, HIGH); }
#else
  inline void rowsOff() { digitalWrite(OE_PIN, HIGH); }
  inline void rowsOn()  { digitalWrite(OE_PIN, LOW);  }
#endif

inline void selectRowGroup(byte g) {
  digitalWrite(B_PIN, (g & 0x02) ? HIGH : LOW);
  digitalWrite(A_PIN, (g & 0x01) ? HIGH : LOW);
}

void clearScreen(bool allOff) {
  memset(screenRAM, allOff ? 0xFF : 0x00, RAM_BYTES);
}

void writePixel(int x, int y, bool on) {
  if (x < 0 || x >= PANEL_WIDTH_PIXELS || y < 0 || y >= PANEL_HEIGHT_PIXELS) return;
  int  idx  = (x / 8) + y * ROW_BYTES;
  byte mask = pixelLookup[x & 0x07];
  if (on) screenRAM[idx] &= ~mask;
  else    screenRAM[idx] |=  mask;
}

void scanDisplay() {
  int offset = ROW_BYTES * scanRow;
  rowsOff();
  for (int i = 0; i < ROW_BYTES; i++) {
    shiftOutByte(screenRAM[offset + i + ROW3_OFFSET]);
    shiftOutByte(screenRAM[offset + i + ROW2_OFFSET]);
    shiftOutByte(screenRAM[offset + i + ROW1_OFFSET]);
    shiftOutByte(screenRAM[offset + i]);
  }
  latchPulse();
  delayMicroseconds(POST_LATCH_BLANK_MICROS);
  selectRowGroup(scanRow);
  delayMicroseconds(ROW_SWITCH_DELAY_MICROS);
  rowsOn();
  delayMicroseconds(ROW_ON_MICROS);
  rowsOff();
  delayMicroseconds(ROW_BLANK_MICROS);
  scanRow = (scanRow + 1) & 0x03;
}

