#define GLYPH_W      (5 + BOLD_X)
#define GLYPH_H      (7 + BOLD_Y)
#define CHAR_ADVANCE (GLYPH_W + 1)

void drawCharBold(int x, int y, char c) {
  if (c < 32 || c > 126) c = 32;
  const byte *glyph = font5x7[c - 32];
  for (int col = 0; col < 5; col++) {
    byte colBits = glyph[col];
    for (int row = 0; row < 7; row++) {
      if (!(colBits & (1 << row))) continue;
      for (int dx = 0; dx <= BOLD_X; dx++)
        for (int dy = 0; dy <= BOLD_Y; dy++)
          writePixel(x + col + dx, y + row + dy, true);
    }
  }
}

void drawStringBold(int x, int y, const char *str) {
  int cx = x;
  while (*str) {
    if (cx > -GLYPH_W && cx < PANEL_WIDTH_PIXELS) drawCharBold(cx, y, *str);
    cx += CHAR_ADVANCE;
    str++;
  }
}

void renderFrame() {
  clearScreen(true);
  drawStringBold(scrollX, textY, scrollBuf);
}

void setText(const char *s) {
  strncpy(scrollBuf, s, MAX_TEXT_LEN);
  scrollBuf[MAX_TEXT_LEN] = '\0';
  textPixelWidth = (int)strlen(scrollBuf) * CHAR_ADVANCE;
  scrollX = PANEL_WIDTH_PIXELS;
  renderFrame();
}

// ============================================================
//  Servos
// ============================================================
void servosInit() {
  servoBio.attach(SERVO_BIO_PIN);
  servoNonBio.attach(SERVO_NONBIO_PIN);
  servoBio.write(ANGLE_CLOSED);
  servoNonBio.write(ANGLE_CLOSED);
  delay(SERVO_TRAVEL_MS);
#if SERVO_DETACH_WHEN_IDLE
  servoBio.detach();
  servoNonBio.detach();
#endif
}

void openLid(bool isBio) {
  activeServo = isBio ? &servoBio : &servoNonBio;
#if SERVO_DETACH_WHEN_IDLE
  activeServo->attach(isBio ? SERVO_BIO_PIN : SERVO_NONBIO_PIN);
#endif
  activeServo->write(ANGLE_OPEN);
}

void closeLid() {
  if (activeServo) activeServo->write(ANGLE_CLOSED);
}

void releaseLid() {
#if SERVO_DETACH_WHEN_IDLE
  if (activeServo) activeServo->detach();
#endif
  activeServo = NULL;
}

void enterState(AppState s, const char *text) {
  appState     = s;
  stateStartMs = millis();
  setText(text);
}

// ============================================================
//  RPC Callbacks invoked by Python Bridge
// ============================================================
void handleOpenBio() {
  if (appState == S_ANALYZING) {
    openLid(true);
    enterState(S_OPEN, "BIO");
    DBG_PRINTLN(F("-> BIO lid OPEN (90)"));
  }
}

void handleOpenNonBio() {
  if (appState == S_ANALYZING) {
    openLid(false);
    enterState(S_OPEN, "NON BIO");
    DBG_PRINTLN(F("-> NON BIO lid OPEN (90)"));
  }
}

// ============================================================
//  BYPASS BUTTON HANDLER  — called first thing in loop()
//  Handles the volatile flag set by ISR_bypass().
//  Safe to use delay() here (emergency path — display pause OK).
// ============================================================
void handleBypass() {
  if (!bypassRequested) return;
  bypassRequested = false;                          // clear flag immediately

  // Reject noise: pin must be truly LOW (actual press), not just a spike
  if (digitalRead(BYPASS_BTN_PIN) == HIGH) return;

  unsigned long now = millis();
  if (now - lastBypassMs < DEBOUNCE_MS) return;    // reject contact bounce
  lastBypassMs = now;

  DBG_PRINTLN(F("-> BYPASS BUTTON: skipping scan/camera"));

  // If a lid is currently open/moving, close it safely before redirecting
  if (activeServo) {
    closeLid();
    delay(SERVO_TRAVEL_MS);   // 600 ms physical travel — display pauses briefly
    releaseLid();
  }

  // Jump straight to NON BIO open; state machine handles close → THANK YOU → idle
  openLid(false);
  enterState(S_OPEN, "NON BIO");
  DBG_PRINTLN(F("-> BYPASS: NON BIO OPEN"));
}

// ============================================================
//  Barcode Reader
// ============================================================
void handleBarcode() {
  while (Serial1.available()) {
    char c = Serial1.read();
    if (barcodeLen < MAX_TEXT_LEN) barcodeRaw[barcodeLen++] = c;
    lastByteMs = millis();
    receiving  = true;
  }
  if (receiving && (millis() - lastByteMs >= BARCODE_TIMEOUT_MS)) {
    receiving = false;
    while (barcodeLen > 0 &&
           (barcodeRaw[barcodeLen-1] == '\r' ||
            barcodeRaw[barcodeLen-1] == '\n' ||
            barcodeRaw[barcodeLen-1] == ' ')) {
      barcodeLen--;
    }
    barcodeRaw[barcodeLen] = '\0';
    if (barcodeLen > 0 && appState == S_IDLE) {
      enterState(S_SHOW_ID, barcodeRaw);
      DBG_PRINT(F("ID: "));
      DBG_PRINTLN(scrollBuf);
      Bridge.notify("on_card_scanned", barcodeRaw);
    }
    barcodeLen = 0;
  }
}

void onScrollComplete() {
  switch (appState) {
    case S_IDLE:
    case S_PREPARE_WASTE:
    case S_ANALYZING:
    case S_OPEN:
    case S_CLOSING:
      scrollX = PANEL_WIDTH_PIXELS;
      break;
    case S_SHOW_ID:
      enterState(S_PREPARE_WASTE, "PLACE WASTE");
      DBG_PRINTLN(F("-> Present waste to camera (5s delay)..."));
      break;
    case S_THANKS:
      enterState(S_IDLE, "SMART BIN");
      DBG_PRINTLN(F("Ready. Waiting for scan..."));
      break;
  }
}

// ============================================================
//  State-machine timers
// ============================================================
void handleTimers() {
  unsigned long elapsed = millis() - stateStartMs;

  // 1. 5s delay elapsed -> trigger Python classification
  if (appState == S_PREPARE_WASTE && elapsed >= PREPARE_DELAY_MS) {
    enterState(S_ANALYZING, "SCANNING...");
    DBG_PRINTLN(F("Triggering Python classification RPC..."));
    Bridge.notify("trigger_classification");
  }
  // 2. Lid open time elapsed -> close lid
  else if (appState == S_OPEN && elapsed >= LID_OPEN_HOLD_MS) {
    closeLid();
    enterState(S_CLOSING, "CLOSING");
    DBG_PRINTLN(F("-> lid CLOSE (0)"));
  }
  // 3. Physical close time elapsed -> release & say Thank You
  else if (appState == S_CLOSING && elapsed >= SERVO_TRAVEL_MS) {
    releaseLid();
    enterState(S_THANKS, "THANK YOU");
    DBG_PRINTLN(F("-> THANK YOU"));
  }
}

// ============================================================
//  SETUP
// ============================================================
void setup() {
  Serial.begin(9600);     // Monitor / Python Bridge RPC
  Serial1.begin(9600);    // GM67 Scanner (D0/D1)

  // Initialize Router Bridge and register RPC handlers
  Bridge.begin();
  Bridge.provide("open_bio",    handleOpenBio);
  Bridge.provide("open_nonbio", handleOpenNonBio);

  // LED matrix pins
  pinMode(DATA_PIN,  OUTPUT);
  pinMode(CLK_PIN,   OUTPUT);
  pinMode(OE_PIN,    OUTPUT);
  pinMode(A_PIN,     OUTPUT);
  pinMode(B_PIN,     OUTPUT);
  pinMode(LATCH_PIN, OUTPUT);

  digitalWrite(A_PIN,     LOW);
  digitalWrite(B_PIN,     LOW);
  digitalWrite(CLK_PIN,   LOW);
  digitalWrite(LATCH_PIN, LOW);
  digitalWrite(DATA_PIN,  HIGH);
  rowsOff();
  clearScreen(true);

  textY = (PANEL_HEIGHT_PIXELS - GLYPH_H) / 2;

  // Bypass button — internal pull-up; press pulls LOW → FALLING edge fires ISR
  pinMode(BYPASS_BTN_PIN, INPUT_PULLUP);
  attachInterrupt(digitalPinToInterrupt(BYPASS_BTN_PIN), ISR_bypass, FALLING);

  servosInit();
  enterState(S_IDLE, "SMART BIN");
  DBG_PRINTLN(F("SMART BIN ready. Waiting for scan..."));
  DBG_PRINTLN(F("Bypass button active on Pin 2."));
}

// ============================================================
//  LOOP
// ============================================================
void loop() {
  handleBypass();    // FIRST — check bypass button before anything can block
  Bridge.update();   // Process RPC messages from Python
  scanDisplay();     // Multiplex LED display
  handleBarcode();   // Read barcode scanner
  handleTimers();    // Handle sequence timing

  unsigned long now = millis();
  if (now - lastScrollMs >= SCROLL_INTERVAL_MS) {
    lastScrollMs = now;
    scrollX--;
    if (scrollX < -(textPixelWidth + GAP_PIXELS)) {
      onScrollComplete();
    } else {
      renderFrame();
    }
  }
}
