// Glyph footprint after dilation
#define GLYPH_W (5 + BOLD_X)
#define GLYPH_H (7 + BOLD_Y)
#define CHAR_ADVANCE (GLYPH_W + 1)

// Draws one glyph, dilating each set bit into a 1x1 / 2x1 / 1x2 / 2x2 block.
void drawCharBold(int x, int y, char c) {
  if (c < 32 || c > 126) c = 32;
  const byte *glyph = font5x7[c - 32];
  for (int col = 0; col < 5; col++) {
    byte colBits = glyph[col];
    for (int row = 0; row < 7; row++) {
      if (!(colBits & (1 << row))) continue;
      for (int dx = 0; dx <= BOLD_X; dx++) {
        for (int dy = 0; dy <= BOLD_Y; dy++) {
          writePixel(x + col + dx, y + row + dy, true);
        }
      }
    }
  }
}

void drawStringBold(int x, int y, const char *str) {
  int cx = x;
  while (*str) {
    // skip glyphs entirely off-screen (saves time on long strings)
    if (cx > -GLYPH_W && cx < PANEL_WIDTH_PIXELS) drawCharBold(cx, y, *str);
    cx += CHAR_ADVANCE;
    str++;
  }
}

// --------------------------------------------------------------------------------------

const char *scrollText = "HELLO SAIRAM";

int textPixelWidth;
int textY;
int scrollX;
unsigned long lastScrollMs = 0;

void renderFrame() {
  clearScreen(true);
  drawStringBold(scrollX, textY, scrollText);
}

void setup() {
  pinMode(DATA_PIN, OUTPUT);
  pinMode(CLK_PIN, OUTPUT);
  pinMode(OE_PIN, OUTPUT);
  pinMode(A_PIN, OUTPUT);
  pinMode(B_PIN, OUTPUT);
  pinMode(LATCH_PIN, OUTPUT);

  digitalWrite(A_PIN, LOW);
  digitalWrite(B_PIN, LOW);
  digitalWrite(CLK_PIN, LOW);
  digitalWrite(LATCH_PIN, LOW);
  digitalWrite(DATA_PIN, HIGH);
  rowsOff();

  textPixelWidth = (int)strlen(scrollText) * CHAR_ADVANCE;
  textY = (PANEL_HEIGHT_PIXELS - GLYPH_H) / 2;
  scrollX = PANEL_WIDTH_PIXELS;      // start just off the right edge

  clearScreen(true);
  renderFrame();
}

void loop() {
  scanDisplay();

  unsigned long now = millis();
  if (now - lastScrollMs >= SCROLL_INTERVAL_MS) {
    lastScrollMs = now;
    scrollX--;
    if (scrollX < -(textPixelWidth + GAP_PIXELS)) scrollX = PANEL_WIDTH_PIXELS;
    renderFrame();
  }
}
